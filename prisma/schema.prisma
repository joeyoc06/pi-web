generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DB_URL")
}

model Recipe {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String
  course           String
  cuisine          String?
  difficulty       String
  prepTimeMinutes  Int
  cookTimeMinutes  Int
  totalTimeMinutes Int
  servings         Float
  tags             Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  imageUrl         String?
  sourceUrl        String?
  ingredients      Json     @default("[]")
  instructions     Json     @default("[]")
}

model Ingredient {
  id       String @id @default(cuid())
  name     String
  category String
}
